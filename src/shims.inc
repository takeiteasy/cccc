    "        __builtin_memcpy(newst.buf, enc + 1, elen - 1);\n"
    "        newst.len = (unsigned char)(elen - 1);\n"
    "        newst.pos = 0;\n"
    "        __builtin_memcpy(ps, &newst, sizeof(newst));\n"
    "    }\n"
    "    return rc;\n"
