static const char CCCC_SHIM_dlfcn_dlclose[] =
    "static int __cccc_native_dlclose(void *token) {\n"
    "    __cccc_dl_error = 0;\n"
    "    struct __cccc_dl_node *n = __cccc_dl_find(token);\n"
    "    if (!n) {\n"
    "        __cccc_dl_error = \"invalid dynamic library handle\";\n"
    "        return -1;\n"
    "    }\n"
