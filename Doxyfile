# Doxyfile for CCCC's public API headers.
#
# Scope is intentionally narrow: only the three headers under include/cccc/
# that CCCC injects into user code (--build, --testing, and the reflection/
# macro FFI). The rest of include/ is ~90 libc/POSIX polyfill headers that
# must not be swept into this documentation.
#
# Run via `./cccc --build build.c --build-target=docs` (see build.c's `docs`
# target) or directly with `doxygen Doxyfile` from the repo root. Output is
# gitignored (build/docs/) and never committed -- see man/BUILD.md for the
# build-target writeup.

PROJECT_NAME             = CCCC
PROJECT_BRIEF            = "C bytecode compiler + VM interpreter"

INPUT                   = include/cccc/building.h \
                           include/cccc/reflection.h \
                           include/cccc/testing.h

OUTPUT_DIRECTORY        = build/docs

GENERATE_HTML           = YES
GENERATE_LATEX          = NO
GENERATE_MAN            = NO

OPTIMIZE_OUTPUT_FOR_C   = YES
MARKDOWN_SUPPORT        = YES

ENABLE_PREPROCESSING    = YES
MACRO_EXPANSION         = NO

# building.h/testing.h/reflection.h @param/@return coverage landed in
# #909/#910/#911. EXTRACT_ALL stays YES regardless: reflection.h's internal
# __builtin_dispatch_*/_1/_2/_3 plumbing macros are deliberately undocumented
# (they back the public macro wrappers but aren't part of the macro-author
# API), and EXTRACT_ALL keeps them in the index without WARN_IF_UNDOCUMENTED
# treating that as an error.
EXTRACT_ALL              = YES

WARN_IF_UNDOCUMENTED     = YES
WARN_NO_PARAMDOC         = YES
# Coverage follow-ups (#909/#910/#911) landed, so this is now a real
# completeness gate: the docs build target (and CI's docs task) fails on
# any @param/@return gap or Doxygen markup error.
WARN_AS_ERROR            = YES
WARN_LOGFILE             = build/docs/doxygen-warnings.log

QUIET                    = YES
